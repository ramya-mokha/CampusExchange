# Server Configurations
PORT=5000
JWT_SECRET=super_secret_campus_exchange_key_12345

# MongoDB Atlas URI (Cloud Database)
# Leave this blank or comment it out to use the automatic local file fallback database
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campus_exchange?retryWrites=true&w=majority

# Cloudinary Credentials (Cloud Storage)
# Leave these blank or comment them out to automatically upload and host images locally on the Express server
# CLOUDINARY_CLOUD_NAME=your_cloudinary_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
